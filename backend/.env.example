# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Postgres connection string. Use a strong, unique password.
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/batik_store

# Comma-separated list of allowed CORS origins (browser origins that may call the API).
# Defaults to local Vite dev servers if not set.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
