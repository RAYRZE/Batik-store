# Copy this file to `.env` to override the default checkout phone number.
# Must be prefixed with VITE_ to be exposed to the client. Format: country code + number, no + or spaces.
VITE_WHATSAPP_NUMBER=62882003067694

# Production API base URL (backend FastAPI di Railway).
# Jika tidak diisi, frontend memakai "/api" yang diproxy oleh Vite (mode development).
# Set di dashboard Vercel sebagai environment variable, contoh:
VITE_API_URL=https://batik-store-production.up.railway.app
